# Copia este archivo como .env y cambia los valores. .env NUNCA se sube a Git.

# development | production   (Docker Compose fuerza production para el contenedor "app")
APP_ENV=development

# Obligatoria. Genera una clave con:  python -c "import secrets; print(secrets.token_hex(32))"
# La aplicación se niega a arrancar con el valor de ejemplo.
SECRET_KEY=cambia-esta-clave

# --- Docker Compose (PostgreSQL) ---
POSTGRES_DB=shoe_counter
POSTGRES_USER=shoe_app
# Usa solo letras y números (va dentro de la URL de conexión).
POSTGRES_PASSWORD=cambia-esta-contrasena
APP_PORT=8088

# --- Ejecución sin Docker (venv) ---
# Con un PostgreSQL propio:
# DATABASE_URL=postgresql+psycopg://shoe_app:contrasena@localhost:5432/shoe_counter
# O, solo para desarrollo rápido, SQLite local:
DATABASE_URL=sqlite:///storage/dev.sqlite3

# --- Archivos ---
MAX_UPLOAD_MB=15
# STORAGE_DIR=storage          (por defecto ./storage)

# --- Sesión y seguridad ---
# true obligatorio detrás de HTTPS (producción). En http://localhost déjalo en false.
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8
LOGIN_MAX_FAILURES_USER=5
LOGIN_MAX_FAILURES_IP=20
LOGIN_LOCK_MINUTES=15
ORDERS_PER_IP_PER_HOUR=10
# true solo si hay un proxy HTTPS (nginx, Caddy…) delante que envía X-Forwarded-*
TRUST_PROXY=false

# --- Detector de zapatos (ONNX) ---
# Carpeta con <versión>/model.onnx + metadata.json. Vacío = ./modelo/exportados
# AI_MODELS_DIR=modelo/exportados
# Versión concreta a usar; vacío = la más reciente.
AI_MODEL_VERSION=
# Vacío = umbral recomendado por la evaluación del modelo (metadata.json)
AI_CONFIDENCE=
AI_IOU=0.5

# --- Recuperación de contraseña por correo (opcional) ---
# Sin SMTP_HOST/SMTP_FROM la recuperación la hace un administrador.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
PUBLIC_BASE_URL=http://localhost:8088
